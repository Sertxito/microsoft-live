<Project>
  <Import Project="..\Directory.Build.props" />
  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.1" PrivateAssets="all" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\src\Harness.Api\Harness.Api.csproj" />
    <Compile Include="$(MSBuildThisFileDirectory)TestSupport.cs" Link="TestSupport.cs" />
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
